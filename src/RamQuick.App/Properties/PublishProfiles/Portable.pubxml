<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Portable RAMQuick folder: self-contained win-x64, runs in place without installation, network access or an installed runtime.
    Run by scripts/publish-portable.ps1: msbuild src/RamQuick.App/RamQuick.App.csproj -restore -t:Publish -p:PublishProfile=Portable -p:Configuration=Release -p:Platform=x64
    SelfContained is set only here: normal builds stay framework-dependent, so RamQuick.App.Tests and
    RamQuick.IntegrationTests can keep referencing RamQuick.exe.
  -->
  <PropertyGroup>
    <!-- Match the script's command-line globals, which take precedence; they are the defaults for a Visual Studio Publish. -->
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WPF and the reflection-heavy LibreHardwareMonitorLib closure are not trim-safe. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- ramquick_engine.dll and the runtime sit beside RamQuick.exe, so nothing is extracted to %TEMP% at run time. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>$([MSBuild]::EnsureTrailingSlash('$(RamQuickRepoRoot)'))artifacts\publish\RamQuick-win-x64\</PublishDir>
    <!--
      Only the Web SDK's FileSystem publish honours this; for this Microsoft.NET.Sdk project
      scripts/publish-portable.ps1 empties PublishDir first, so stale files never reach the zip.
    -->
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <!-- The UI and logs are English only; no other satellite assemblies ship. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
